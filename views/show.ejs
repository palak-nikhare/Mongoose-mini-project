<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show chat</title>
</head>
<body>
    <h3>Show Chat: <%=chat._id%></h3>

    <div>from : <%=chat.from%> </div>
    <br>
    <div>to : <%=chat.to%> </div>
    <hr>
    <textarea name="msg" rows="5" cols="40"><%=chat.msg%></textarea>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>add new chat</title>
    <link rel="stylesheet" href="/new.css" />
</head>
<body>
    <h3>Write new chat...</h3>
    <form class="formm" method="post" action="/chats">
        <input placeholder="Who are you?" name="from">
        <br><br>
        <textarea name="msg">Write your message here</textarea>
        <br><br>
        <input placeholder="Add receiver" name="to">
        <br><br>
        <button>Create Chat</button>
    </form>
</body>
</html>